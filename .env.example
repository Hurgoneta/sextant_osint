# Sextant configuration. Copy to .env and fill in only what you want: every key is optional.
# Keys can also be entered in the app (Data Sources → Configure); those are stored encrypted in the local
# database. Values from this file are read at startup and never written anywhere else.
# Nothing is uploaded to any server run by this project. A configured provider receives only the
# selector it is asked about (shown per source before you run it).

# --- Local data -------------------------------------------------------------------------------
# Derive the database key from a passphrase (recommended). Without it a random key file is used.
# SEXTANT_PASSPHRASE=
# Data directory (default: ~/.local/share/sextant, %APPDATA%\Sextant)
# SEXTANT_DATA_DIR=

# --- Free — optional keys that raise rate limits -------------------------------------------------
# Certspotter (SSLMate): Certspotter API key — https://sslmate.com/certspotter/api
# CERTSPOTTER_API_KEY=
# CourtListener (US federal dockets): CourtListener API token — https://www.courtlistener.com/help/api/rest/
# COURTLISTENER_TOKEN=
# US FEC — individual contributions: api.data.gov key — https://api.data.gov/signup/
# FEC_API_KEY=
# GitHub: GitHub token — https://github.com/settings/tokens
# GITHUB_TOKEN=
# Gravatar: Gravatar API key — https://gravatar.com/developers
# GRAVATAR_API_KEY=
# OpenAlex: OpenAlex API key — https://openalex.org/settings/api
# OPENALEX_API_KEY=
# Stack Exchange (Stack Overflow): Stack Exchange app key — https://stackapps.com/apps/oauth/register
# STACKEXCHANGE_KEY=

# --- Free with registration (a free account or key is required) ----------------------------------
# AbuseIPDB: AbuseIPDB API key — https://www.abuseipdb.com/account/api
# ABUSEIPDB_API_KEY=
# Australia — ABN Lookup: ABN Lookup GUID — https://abr.business.gov.au/Tools/WebServices
# ABN_LOOKUP_GUID=
# EmailRep: EmailRep API key — https://emailrep.io/key
# EMAILREP_API_KEY=
# GreyNoise Community: GreyNoise API key — https://viz.greynoise.io/account/api-key
# GREYNOISE_API_KEY=
# Hunter.io: Hunter.io API key — https://hunter.io/api-keys
# HUNTER_API_KEY=
# ipinfo.io: ipinfo token — https://ipinfo.io/signup
# IPINFO_TOKEN=
# numverify (apilayer): apilayer API key (Number Verification) — https://apilayer.com/marketplace/number_verification-api
# NUMVERIFY_API_KEY=
# OpenCorporates: OpenCorporates API token — https://opencorporates.com/api_accounts/new
# OPENCORPORATES_API_TOKEN=
# OpenSanctions API: OpenSanctions API key — https://www.opensanctions.org/api/
# OPENSANCTIONS_API_KEY=
# SearXNG (self-hosted): SearXNG URL — https://docs.searxng.org/admin/installation.html
# SEARXNG_URL=
# Steam Web API: Steam Web API key — https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=
# Twitch Helix API: Twitch client id — https://dev.twitch.tv/console/apps
# TWITCH_CLIENT_ID=
# Twitch Helix API: Twitch client secret — https://www.twitch.tv
# TWITCH_CLIENT_SECRET=
# UK Companies House: Companies House API key — https://developer.company-information.service.gov.uk/
# COMPANIES_HOUSE_API_KEY=
# urlscan.io: urlscan.io API key — https://urlscan.io/user/profile/
# URLSCAN_API_KEY=
# VirusTotal: VirusTotal API key — https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=
# YouTube Data API: YouTube Data API v3 key — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY=

# --- Platform approval required (the platform decides who gets access) ---------------------------
# Instagram Business Discovery: Instagram Graph API access token — https://developers.facebook.com/docs/instagram-platform/
# INSTAGRAM_ACCESS_TOKEN=
# Instagram Business Discovery: Your Instagram business account id — https://www.instagram.com
# INSTAGRAM_BUSINESS_ID=
# Reddit: Reddit app client id — https://support.reddithelp.com/hc/en-us/articles/42728983564564-Responsible-Builder-Policy
# REDDIT_CLIENT_ID=
# Reddit: Reddit app secret — https://www.reddit.com
# REDDIT_CLIENT_SECRET=

# --- Pay-per-use — every query costs money on YOUR account ---------------------------------------
# Brave Search API: Brave Search API key — https://api-dashboard.search.brave.com/
# BRAVE_API_KEY=
# Serper (Google results API): Serper API key — https://serper.dev/api-key
# SERPER_API_KEY=
# Tavily Search API: Tavily API key — https://app.tavily.com/
# TAVILY_API_KEY=
# Google Programmable Search (JSON API): Google API key — https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_KEY=
# Google Programmable Search (JSON API): Search engine id (cx) — https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_CX=
# X (Twitter) API: X API bearer token — https://developer.x.com/
# X_BEARER_TOKEN=

# --- Paid subscription — use only if you hold a licence for this purpose -------------------------
# Have I Been Pwned: HIBP API key — https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=
# People Data Labs: People Data Labs API key — https://dashboard.peopledatalabs.com/
# PDL_API_KEY=
# SecurityTrails: SecurityTrails API key — https://securitytrails.com/app/account/credentials
# SECURITYTRAILS_API_KEY=
# SerpApi: SerpApi key — https://serpapi.com/manage-api-key
# SERPAPI_KEY=
# Shodan (host API): Shodan API key — https://account.shodan.io/
# SHODAN_API_KEY=
# TinEye reverse image search: TinEye API key — https://services.tineye.com/TinEyeAPI
# TINEYE_API_KEY=
# Twilio Lookup v2: Twilio account SID — https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# Twilio Lookup v2: Twilio auth token — https://www.twilio.com/lookup
# TWILIO_AUTH_TOKEN=

# --- Enterprise contracts ------------------------------------------------------------------------
# Pipl: Pipl API key — https://pipl.com/api
# PIPL_API_KEY=

# --- Local tools (adapters) — path to an installed executable; leave empty to look it up on PATH ---
# Maigret (adapter): Path to the maigret executable — https://github.com/soxoj/maigret
# MAIGRET_PATH=
# Sherlock (adapter): Path to the sherlock executable — https://github.com/sherlock-project/sherlock
# SHERLOCK_PATH=
# SpiderFoot (adapter): Path to SpiderFoot's sf.py — https://github.com/smicallef/spiderfoot
# SPIDERFOOT_PATH=
# theHarvester (adapter): Path to theHarvester — https://github.com/laramies/theHarvester
# THEHARVESTER_PATH=

# --- AI providers of the assistant (optional; one key per provider account) ----------------------
# Choose the primary provider, model and failover order in Settings → AI providers. Usage is recorded per provider,
# whichever feature uses the key. AI_API_KEY is the legacy single key: it applies to the primary provider only.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LOCAL_AI_API_KEY=
# COMPATIBLE_AI_API_KEY=
# AI_API_KEY=
